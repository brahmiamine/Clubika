# Copiez ce fichier vers deploy/.env sur le VPS (jamais commité).
# Les secrets vont dans deploy/secrets/ (mode 700, fichiers 600) — pas ici.
# openssl rand -hex 32  → secrets/app_encryption_key, backup_encryption_key, cron_secret
# openssl rand -base64 24 → mots de passe DB (sans caractère hors [A-Za-z0-9+/=_-])

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
TZ=Europe/Paris

# --- MariaDB (Compose) ---
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=clubika
DB_USER=clubika
DB_BACKUP_USER=clubika_backup
DB_RESTORE_USER=clubika_restore

# --- URL publique ---
# HTTPS canonique obligatoire. Les liens sensibles ne sont jamais dérivés de Host.
APP_BASE_URL=https://clubika.com
APP_PUBLIC_ORIGIN_ALLOWLIST=https://clubika.com
# Origines CSRF / WebSocket supplémentaires (CSV). Ne pas y mettre d’hôtes non inventoriés.
# CSRF_ALLOWED_ORIGINS=
APP_CLUB_ID=afp

# --- Chiffrement (fichiers secrets/, jamais dans .env) ---
# secrets/app_encryption_key et secrets/backup_encryption_key (distinctes).
# Sauvegardez-les HORS du VPS, séparément des dumps.
# APP_ENCRYPTION_KEY_ID=k1
# APP_ENCRYPTION_PREVIOUS_KEYS=
# BACKUP_ENCRYPTION_KEY_ID=b1
BACKUP_KEEP_DAYS=14

# --- Sessions ---
# Cookie HttpOnly, Path=/, sans Domain, préfixe __Host- en production HTTPS.
# SESSION_TOKEN_PEPPER optionnel (repli APP_ENCRYPTION_KEY, fichier secret).
SESSION_TTL_DAYS=30
SESSION_IDLE_TTL_HOURS=168
SESSION_ADMIN_IDLE_TTL_HOURS=12
SESSION_ADMIN_ABSOLUTE_TTL_DAYS=7
PLATFORM_SESSION_IDLE_TTL_HOURS=4
PLATFORM_SESSION_ABSOLUTE_TTL_HOURS=12

# --- Reverse-proxy Caddy (ne pas changer avec ce Compose) ---
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_COUNT=1
CHAT_INSTANCE_COUNT=1

# --- Bootstrap (mots de passe : secrets/ ; retirer après la 1re connexion et l'enrôlement MFA) ---
BOOTSTRAP_SUPERADMIN_EMAIL=admin@clubika.com
BOOTSTRAP_APPROVAL=
PLATFORM_ADMIN_EMAIL=plateforme@clubika.com
PLATFORM_BOOTSTRAP_APPROVAL=

# --- Synchro calendrier externe (issue #4 / #30) ---
# Laisser false tant qu'une licence / autorisation écrite n'a pas été validée.
# true ne suffit pas : le flag club scraperSync doit aussi être activé.
SPORTCORICO_SYNC_ENABLED=false

# --- Web Push (optionnel — WEB_PUSH_ENABLED=true requis, issue #30) ---
# Clé privée : secrets/vapid_private_key
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@clubika.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
WEB_PUSH_ENABLED=

# --- SMTP global (optionnel ; SMTP_ENABLED=true requis, TLS vérifié) ---
# Mot de passe : secrets/smtp_password
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SECURE=false
SMTP_FROM=
# SMTP_ALLOWED_HOSTS=

# --- WhatsApp (optionnel — désactivé par défaut, issue #17) ---
# Secrets seuls = canal off. WHATSAPP_PROVIDER=meta|webhook après revue.
# Désactivation immédiate : vider WHATSAPP_PROVIDER et redémarrer.
# Voir docs/whatsapp-activation.md
WHATSAPP_PROVIDER=
WHATSAPP_DEFAULT_COUNTRY_CODE=33
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_GRAPH_VERSION=
WHATSAPP_META_TEMPLATE_NAME=
WHATSAPP_META_TEMPLATE_LANGUAGE=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_TOKEN=

# --- Rapports post-événement (issue #8) ---
# Durée opérationnelle. Base légale : issue #9.
POST_EVENT_REPORT_RETENTION_DAYS=365

# --- Météo / routage / logos (off par défaut, issue #30) ---
# Voir docs/external-services.md — ne pas activer avant revue juridique.
OPEN_METEO_ENABLED=
OPEN_METEO_FORECAST_URL=
OPEN_METEO_GEOCODING_URL=
ROUTING_ENABLED=
ROUTING_API_BASE_URL=
LOGO_PROXY_ENABLED=
LOGO_PROXY_ALLOWED_HOSTS=

# --- Données de santé (issue #7) ---
# Laisser vide pour le dry-run (comptage uniquement). Appliquer la purge :
# HEALTH_COMMENT_PURGE=apply

# Quarantaine SportCorico (issue #5) — laisser commenté (dry-run).
# Après dump MariaDB : SPORTCORICO_DATA_PURGE=apply puis
# `pnpm run sportcorico:quarantine`. Voir docs/sportcorico-data-quarantine.md.
# SPORTCORICO_DATA_PURGE=

# Attestation opérateur bloquante (issue #36). Mettre à 1 seulement après avoir
# vérifié : pare-feu hôte 22/80/443 uniquement, MariaDB non publiée, moteur
# Docker avec seccomp par défaut (pas seccomp=unconfined), NTP/horloge, SSH par clé.
HOST_FIREWALL_CONFIRMED=0
