# Copiez ce fichier vers deploy/.env sur le VPS (jamais commité).
# openssl rand -hex 32   → APP_ENCRYPTION_KEY et CRON_SECRET
# openssl rand -base64 24 → mots de passe DB
# node scripts/generate-vapid-keys.mjs → clés Web Push

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
TZ=Europe/Paris

# --- MariaDB (Compose) ---
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=clubika
DB_USER=clubika
DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# --- URL publique ---
APP_BASE_URL=https://clubika.com
# Origines CSRF / WebSocket supplémentaires (CSV). Ne pas y mettre d’hôtes non inventoriés.
# CSRF_ALLOWED_ORIGINS=
APP_CLUB_ID=afp

# --- Chiffrement (OBLIGATOIRE) ---
# Sauvegardez ces clés HORS du VPS, séparément des dumps.
# openssl rand -hex 32
APP_ENCRYPTION_KEY=
# APP_ENCRYPTION_KEY_ID=k1
# APP_ENCRYPTION_PREVIOUS_KEYS=
BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY_ID=b1
BACKUP_KEEP_DAYS=14

# --- Sessions ---
SESSION_TTL_DAYS=30

# --- Reverse-proxy Caddy (ne pas changer avec ce Compose) ---
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_COUNT=1
CHAT_INSTANCE_COUNT=1

# --- Bootstrap : retirer ces 4 lignes après la première connexion ---
BOOTSTRAP_SUPERADMIN_EMAIL=admin@clubika.com
BOOTSTRAP_SUPERADMIN_PASSWORD=change-me
PLATFORM_ADMIN_EMAIL=plateforme@clubika.com
PLATFORM_ADMIN_PASSWORD=change-me

# --- Cron (OBLIGATOIRE pour /api/cron/*) ---
CRON_SECRET=

# --- Synchro calendrier externe (issue #4 / #30) ---
# Laisser false tant qu'une licence / autorisation écrite n'a pas été validée.
# true ne suffit pas : le flag club scraperSync doit aussi être activé.
SPORTCORICO_SYNC_ENABLED=false

# --- Web Push (optionnel — WEB_PUSH_ENABLED=true requis, issue #30) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@clubika.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
WEB_PUSH_ENABLED=

# --- SMTP global (optionnel ; SMTP_ENABLED=true requis, TLS vérifié) ---
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=
# SMTP_ALLOWED_HOSTS=

# --- WhatsApp (optionnel — désactivé par défaut, issue #17) ---
# Secrets seuls = canal off. WHATSAPP_PROVIDER=meta|webhook après revue.
# Désactivation immédiate : vider WHATSAPP_PROVIDER et redémarrer.
# Voir docs/whatsapp-activation.md
WHATSAPP_PROVIDER=
WHATSAPP_DEFAULT_COUNTRY_CODE=33
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_GRAPH_VERSION=
WHATSAPP_META_TEMPLATE_NAME=
WHATSAPP_META_TEMPLATE_LANGUAGE=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_TOKEN=

# --- Météo / routage / logos (off par défaut, issue #30) ---
# Voir docs/external-services.md — ne pas activer avant revue juridique.
OPEN_METEO_ENABLED=
OPEN_METEO_FORECAST_URL=
OPEN_METEO_GEOCODING_URL=
ROUTING_ENABLED=
ROUTING_API_BASE_URL=
LOGO_PROXY_ENABLED=
LOGO_PROXY_ALLOWED_HOSTS=

# --- Données de santé (issue #7) ---
# Laisser vide pour le dry-run (comptage uniquement). Appliquer la purge :
# HEALTH_COMMENT_PURGE=apply

# Quarantaine SportCorico (issue #5) — laisser commenté (dry-run).
# Après dump MariaDB : SPORTCORICO_DATA_PURGE=apply puis
# `pnpm run sportcorico:quarantine`. Voir docs/sportcorico-data-quarantine.md.
# SPORTCORICO_DATA_PURGE=
