# Copiez ce fichier vers deploy/.env sur le VPS (jamais commité).
# Les secrets vont dans deploy/secrets/ (mode 700, fichiers 600) — pas ici.
# openssl rand -hex 32  → secrets/app_encryption_key et secrets/cron_secret
# openssl rand -base64 24 → mots de passe DB (sans caractère hors [A-Za-z0-9+/=_-])

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
TZ=Europe/Paris

# --- MariaDB (Compose) ---
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=clubika
DB_USER=clubika
DB_BACKUP_USER=clubika_backup
DB_RESTORE_USER=clubika_restore

# --- URL publique ---
# HTTPS canonique obligatoire. Les liens sensibles ne sont jamais dérivés de Host.
APP_BASE_URL=https://clubika.com
APP_PUBLIC_ORIGIN_ALLOWLIST=https://clubika.com
APP_CLUB_ID=afp

# --- Sessions ---
SESSION_TTL_DAYS=30

# --- Reverse-proxy Caddy (ne pas changer avec ce Compose) ---
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_COUNT=1
CHAT_INSTANCE_COUNT=1

# --- Bootstrap (fichiers optionnels dans secrets/, à retirer après la 1re connexion) ---
BOOTSTRAP_SUPERADMIN_EMAIL=admin@clubika.com
PLATFORM_ADMIN_EMAIL=plateforme@clubika.com

# --- Web Push (la clé privée éventuelle : secrets/vapid_private_key) ---
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@clubika.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- SMTP global (mot de passe éventuel : secrets/smtp_password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SECURE=false
SMTP_FROM=

# --- WhatsApp (optionnel) ---
WHATSAPP_PROVIDER=
WHATSAPP_DEFAULT_COUNTRY_CODE=33

# Attestation opérateur bloquante (issue #36). Mettre à 1 seulement après avoir
# vérifié : pare-feu hôte 22/80/443 uniquement, MariaDB non publiée, moteur
# Docker avec seccomp par défaut (pas seccomp=unconfined), NTP/horloge, SSH par clé.
HOST_FIREWALL_CONFIRMED=0
