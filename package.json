{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "clubika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "dev": "./start.sh",
    "dev:app": "tsx server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 99",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "scrape": "node --import tsx scraper.js",
    "db:import:categories-clubs": "node scripts/import-categories-clubs.mjs",
    "clean": "rm -rf .next out node_modules/.cache",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "routes:coverage": "node scripts/route-test-coverage.mjs",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "audit:actions": "node scripts/check-action-pins.mjs",
    "audit:exceptions": "node scripts/check-exceptions.mjs",
    "postinstall": "npx playwright install chromium --with-deps || echo 'Playwright installation skipped'",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "sportcorico:quarantine": "tsx scripts/apply-sportcorico-quarantine.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.45.0",
    "mariadb": "^3.5.4",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.4",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.9",
    "playwright": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "typeorm": "^0.3.31",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@playwright/test": "1.63.0",
      "playwright": "1.63.0",
      "playwright-core": "1.63.0"
    }
  }
}
