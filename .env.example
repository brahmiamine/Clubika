# Copiez ce fichier vers `.env.local` (ou exportez ces variables dans votre environnement).
# Ne commitez jamais de secrets réels.

# --- Base de données (MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clubika_user
DB_PASSWORD=change-me
DB_NAME=clubika

# --- Serveur Next.js ---
NODE_ENV=development
HOSTNAME=0.0.0.0
PORT=3000

# --- Chiffrement (OBLIGATOIRE en production) ---
# Chiffre les messages de chat et les mots de passe SMTP par club (AES-256-GCM, enc:v2).
# En production, le boot est refusé si APP_ENCRYPTION_KEY est absente.
APP_ENCRYPTION_KEY=
# Identifiant de la clé active (anneau). Défaut k1.
# APP_ENCRYPTION_KEY_ID=k1
# Anciennes clés en lecture seule pendant une rotation : id:matériau,id:matériau
# APP_ENCRYPTION_PREVIOUS_KEYS=k0:ancien-secret
# Clé DISTINCTE pour les dumps MariaDB (jamais dans le dump).
# BACKUP_ENCRYPTION_KEY=

# --- Club historique / bootstrap JSON uniquement ---
# Identifiant du club par défaut pour le bootstrap JSON one-shot et les tests locaux.
# Ce n'est PAS un fallback silencieux du contexte tenant planning (issue #333).
APP_CLUB_ID=afp

# --- URL publique de l'application (liens e-mail, reset mot de passe, invitations, CSRF) ---
# Obligatoire en production : HTTPS canonique, jamais dérivée de Host / X-Forwarded-Host (issue #32).
APP_BASE_URL=http://localhost:3000
# Optionnel : si défini, APP_BASE_URL doit figurer dans cette liste d'origines.
# APP_PUBLIC_ORIGIN_ALLOWLIST=https://planning.exemple.fr
# Origines supplémentaires autorisées pour CSRF / WebSocket (CSV), hors APP_BASE_URL.
# CSRF_ALLOWED_ORIGINS=https://preview.exemple.fr

# --- Bootstrap administrateur club (premier compte uniquement) ---
BOOTSTRAP_SUPERADMIN_EMAIL=admin@exemple.fr
BOOTSTRAP_SUPERADMIN_PASSWORD=change-me
# En production, second secret d'approbation (double contrôle, issue #32) :
# BOOTSTRAP_APPROVAL=
# Alias historiques (évités si BOOTSTRAP_SUPERADMIN_* est défini) :
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Bootstrap administrateur plateforme (/plateforme) ---
PLATFORM_ADMIN_EMAIL=plateforme@exemple.fr
PLATFORM_ADMIN_PASSWORD=change-me
# En production, second secret d'approbation (double contrôle, issue #32) :
# PLATFORM_BOOTSTRAP_APPROVAL=

# Paramètre scrypt (puissance de 2 ≥ 16384). Défaut 32768 hors tests ; OWASP cite 2^17.
# PASSWORD_SCRYPT_N=32768
# Contrôle des mots de passe compromis : local (défaut), hibp (k-anonymity, prestataire à valider), off.
# COMPROMISED_PASSWORD_CHECK=local

# --- Cron (OBLIGATOIRE en production pour /api/cron/*) ---
CRON_SECRET=change-me

# --- Scraper / calendrier externe ---
# Désactivé par défaut (issue #4). Ne jamais passer à true sans licence / autorisation
# écrite couvrant précisément l’API et la réutilisation des données, revue par un humain.
# Le flag club scraperSync est également false par défaut et ne suffit pas à lui seul.
SPORTCORICO_SYNC_ENABLED=false

# Identifiants de source (administrés depuis /plateforme en prod multi-club).
# Inutiles tant que SPORTCORICO_SYNC_ENABLED n’est pas true.
SCRAPER_MATCHES_URL_KEY=
SCRAPER_CLUB_NAME=
# Quarantaine des données déjà importées (issue #5). Absent = dry-run à la
# migration 0027. `apply` active les écritures via `pnpm run sportcorico:quarantine`
# après sauvegarde MariaDB — jamais depuis une PR.
# SPORTCORICO_DATA_PURGE=

# --- Notifications push (Web Push / VAPID) ---
# Les clés VAPID ne suffisent plus : WEB_PUSH_ENABLED=true est requis (issue #30).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@exemple.fr
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
WEB_PUSH_ENABLED=

# --- E-mail SMTP global (repli ; chaque club peut surcharger en configuration) ---
# Désactivé tant que SMTP_ENABLED n’est pas exactement true (issue #30).
# Port 587 = STARTTLS obligatoire ; port 465 / SMTP_SECURE=true = TLS implicite.
# SMTP_ALLOW_INSECURE=true uniquement hors production (mail local).
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=
# SMTP_ALLOWED_HOSTS=
# SMTP_ALLOW_INSECURE=

# --- Réinitialisation mot de passe ---
# Envoi uniquement par SMTP (le webhook avec jeton brut a été retiré). Voir docs/external-services.md.

# --- WhatsApp (optionnel — DÉSACTIVÉ par défaut, issue #17) ---
# Ne jamais compter sur la seule présence de secrets : il faut poser
# explicitement WHATSAPP_PROVIDER=meta ou webhook. Laisser vide = canal off.
# Procédure : docs/whatsapp-activation.md (revue contractuelle avant prod).
WHATSAPP_PROVIDER=
WHATSAPP_DEFAULT_COUNTRY_CODE=33
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_GRAPH_VERSION=
WHATSAPP_META_TEMPLATE_NAME=
WHATSAPP_META_TEMPLATE_LANGUAGE=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_WEBHOOK_INCLUDE_EVENT_CONTEXT=

# --- Météo / routage (aucun fallback public en production, issue #30) ---
OPEN_METEO_ENABLED=
OPEN_METEO_FORECAST_URL=
OPEN_METEO_GEOCODING_URL=
ROUTING_ENABLED=
ROUTING_API_BASE_URL=

# --- Proxy de logos distants ---
LOGO_PROXY_ENABLED=
LOGO_PROXY_ALLOWED_HOSTS=

# --- Sessions (issue #29) ---
# Jeton cookie uniquement ; la base stocke un HMAC versionné.
# SESSION_TOKEN_PEPPER=   # optionnel ; repli sur APP_ENCRYPTION_KEY
# SESSION_IDLE_TTL_HOURS=168
# SESSION_TTL_DAYS=30
# SESSION_ADMIN_IDLE_TTL_HOURS=12
# SESSION_ADMIN_ABSOLUTE_TTL_DAYS=7
# PLATFORM_SESSION_IDLE_TTL_HOURS=4
# PLATFORM_SESSION_ABSOLUTE_TTL_HOURS=12
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_COUNT=1
# SESSION_COOKIE_HOST_PREFIX=false

# --- Rapports post-événement (issue #8) ---
# Durée opérationnelle en jours. Base légale / politique globale : issue #9.
POST_EVENT_REPORT_RETENTION_DAYS=365

# --- Rétention / purge (issue #9) ---
# Durées produit en jours, PAS une obligation légale. Voir docs/retention.md.
# RETENTION_CHAT_DAYS=365
# RETENTION_PLANNING_ATTACHMENTS_DAYS=365
# RETENTION_REPORTS_DAYS=365
# RETENTION_AUDIT_DAYS=365
# RETENTION_SESSIONS_DAYS=30
# RETENTION_NOTIFICATIONS_DAYS=180
# RETENTION_INVITATIONS_DAYS=90
# RETENTION_PASSWORD_RESET_DAYS=7
# RETENTION_PUSH_DAYS=365
# RETENTION_SCRAPER_RUNS_DAYS=90
# RETENTION_OUTBOX_DAYS=30
# RETENTION_RATE_LIMITS_DAYS=14
# RETENTION_PUBLIC_SHARES_DAYS=90
# RETENTION_PUBLIC_SHARES_EXPIRED_DAYS=7
# RETENTION_BATCH_SIZE=200

# --- Partage public du planning (issue #14) ---
# Durée maximale proposée pour un nouveau lien, en jours (7 j par défaut, non
# modifiable ici). PAS une obligation légale. Plafonnée à 90 j quelle que soit la
# valeur fournie. Voir docs/retention.md.
# PUBLIC_SHARE_MAX_EXPIRY_DAYS=30

# --- Tests ---
REQUIRE_DB_TESTS=0
E2E_BASE_URL=

# --- Données de santé (issue #7) ---
# Dry-run par défaut : la migration 0026 recale `injury` → `personal` et compte
# les commentaires libres sans les supprimer. Pour les retirer après revue des
# volumes (sans classification automatique du texte) :
# HEALTH_COMMENT_PURGE=apply

# --- Mentions légales (issue #12) ---
# Identité de l’éditeur / hébergeur. Sans nom + adresse + e-mail, /mentions-legales
# indique que la page est incomplète et n’invente aucune société.
# LEGAL_PUBLISHER_NAME=
# LEGAL_PUBLISHER_LEGAL_FORM=
# LEGAL_PUBLISHER_ADDRESS=
# LEGAL_PUBLISHER_EMAIL=
# LEGAL_PUBLISHER_PHONE=
# LEGAL_HOSTING_PROVIDER=
# LEGAL_HOSTING_COUNTRY=
# Contact DPO affiché seulement s’il est renseigné (art. 37 non tranché) :
# LEGAL_DPO_EMAIL=

